# =============================================================================
# Trading bot environment — copy to .env and fill in values.
# NEVER commit .env. NEVER put passwords in Python source files.
# =============================================================================

# --- Safety (defaults are DEMO / paper only) ---
# DEMO | LIVE   — LIVE is blocked unless ALLOW_LIVE_TRADING is also set.
TRADING_MODE=DEMO
# Must be exactly YES_I_UNDERSTAND to permit live execution. Leave empty.
ALLOW_LIVE_TRADING=
# If true, strategy runs and logs WOULD_ENTER. No MT5 order is sent.
DRY_RUN=true

# Browser. False during development so you can watch the session.
HEADLESS=false
SLOW_MO_MS=0
BROWSER_CHANNEL=chrome
# Named Chrome profile folder inside BROWSER_PROFILE_DIR (Default, Profile 1, Profile 52).
# Leave empty to use Playwright's Default profile.
CHROME_PROFILE_DIRECTORY=
REQUIRE_CHROME_CLOSED=true
# Live Chrome User Data used only as the copy source. Leave empty if unused.
CHROME_SOURCE_USER_DATA_DIR=

# --- Chart site (TradingView is chart-only; orders go to MT5) ---
BROKER_URL=https://www.tradingview.com/chart/?symbol=XAUUSD&interval=1
LOGIN_URL=
TRADING_PAGE_URL=https://www.tradingview.com/chart/?symbol=XAUUSD&interval=1
ACCOUNT_NAME=

# Optional. Leave blank when the persistent Chrome profile is already logged in.
BROKER_USERNAME=
BROKER_PASSWORD=

# --- Market ---
SYMBOL=XAUUSD
TIMEFRAME=1M
TRADE_ON_CANDLE_CLOSE=true

# --- Stale data ---
MAX_PRICE_STALENESS_SECONDS=10

# --- Risk ---
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_SIZE=1.0
MAX_OPEN_TRADES=1
MAX_TRADES_PER_DAY=5
MAX_DAILY_LOSS=100
MAX_CONSECUTIVE_LOSSES=3
SL_OFFSET=0.80
TP_RR=0

EXECUTION_BACKEND=MT5
OPEN_TRADINGVIEW=true
CANDLE_POLL_SECONDS=3
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=
MT5_MAGIC=26092301
MT5_DEVIATION=30

# --- Paths ---
BROWSER_PROFILE_DIR=./browser_profile
SCREENSHOTS_DIR=./screenshots
LOGS_DIR=./logs
SELECTORS_FILE=./config/selectors.yaml
DATABASE_URL=sqlite+aiosqlite:///./data/trading_bot.db

# --- Logging / dashboard ---
LOG_LEVEL=INFO
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# --- Recovery ---
# If true, an unexpected process crash will close bot-owned positions.
# Default false: a crash must NOT automatically flatten positions.
CLOSE_POSITIONS_ON_CRASH=false
